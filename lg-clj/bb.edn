{;; lg-jukyu — clj-native port of the Python LangGraph server (ADR-2606280030).
 ;; Scoped to this app only (does NOT touch the repo-root bb.edn).
 ;;
 ;;   src   — lg-jukyu.* namespaces (12 graphs + server + audit + llm + store seam)
 ;;   test  — lg-jukyu.smoke-test (clojure.test)
 ;;
 ;; Run the suite:  bb test   (or:  bb run_tests.clj)
 ;;
 ;; COEXISTENCE: the deployed runtime is the FastAPI pod under `lg/` (Python +
 ;; langgraph.json + Dockerfile + Helm). This clj twin is ADDITIVE — it ports the
 ;; graph topology, node behaviour and dispatch surface, with RisingWave/psycopg
 ;; replaced by an injectable store seam (kotoba-Datom-log target; the substrate
 ;; boundary forbids RisingWave) and the LiteLLM gateway replaced by the Murakumo
 ;; loopback (ADR-2605215000). Nothing here disturbs the live pod.
 :paths ["src" "test"]
 :deps {com-junkawasaki/langchain-clj
        {:git/url "https://github.com/com-junkawasaki/langchain-clj"
         :git/sha "2b03859c3ee722b64f3eddd0b615a54019b17c81"}
        com-junkawasaki/langgraph-clj
        {:git/url "https://github.com/com-junkawasaki/langgraph-clj"
         :git/sha "c7daa07d4e50f55d7e2a02e4b89dbeb2b200961d"}}
 :tasks
 {test {:doc "Run the clojure.test suite under bb."
        :task (load-file "run_tests.clj")}
  server {:doc "Start through the explicit Babashka host adapter."
          :task (apply shell "bb" "run_tests.clj" "--server" *command-line-args*)}}}
