{
  "dependencies": ["."],
  "graphs": {
    "health":                   "lg_jukyu.graphs.health:GRAPH",
    "query_balance":            "lg_jukyu.graphs.query_balance:GRAPH",
    "query_supply_chain":       "lg_jukyu.graphs.query_supply_chain:GRAPH",
    "rank_company_exposure":    "lg_jukyu.graphs.rank_company_exposure:GRAPH",
    "explain_node":             "lg_jukyu.graphs.explain_node:GRAPH",
    "run_stress_propagation":   "lg_jukyu.graphs.run_stress_propagation:GRAPH",
