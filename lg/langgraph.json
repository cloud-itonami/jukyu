      "schedule": "7 * * * *",
      "input": { "domain": "naphtha" }
    },
    {
      "graph": "normalize_domain_adapter",
      "schedule": "17 * * * *",
      "input": { "domain": "crude_oil" }
    },
    {
      "graph": "normalize_domain_adapter",
      "schedule": "27 */2 * * *",
      "input": { "domain": "energy" }
    },
    {
      "graph": "normalize_domain_adapter",
      "schedule": "37 */2 * * *",
      "input": { "domain": "food" }
    },
    {
      "graph": "normalize_domain_adapter",
      "schedule": "47 */3 * * *",
      "input": { "domain": "metals" }
    },
    {
      "graph": "normalize_domain_adapter",
      "schedule": "57 */3 * * *",
      "input": { "domain": "logistics" }
    },
    {
      "graph": "normalize_domain_adapter",
      "schedule": "3 */6 * * *",
      "input": { "domain": "transport" }
    }
  ]
